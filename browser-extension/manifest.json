{
  "action": {
    "default_popup": "src/entrypoint/BrowserAction/index.html",
    "default_title": "AB Download Manager"
  },
  "author": "AmirHossein Abdolmotallebi",
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "src/entrypoint/ContentScript.js"
      ],
      "matches": [
        "*://*/*"
      ],
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "youtube-button.js"
      ]
    }
  ],
  "default_locale": "en",
  "description": "Download files with AB Download Manager app",
  "homepage_url": "https://abdownloadmanager.com",
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "128": "icons/icon-128.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "AB Download Manager Browser Integration",
  "options_ui": {
    "open_in_tab": true,
    "page": "src/entrypoint/OptionUi/index.html"
  },
  "permissions": [
    "contextMenus",
    "webRequest",
    "cookies",
    "storage",
    "tabs",
    "downloads",
    "notifications",
    "nativeMessaging"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "1.5.2.15",
  "web_accessible_resources": [
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "assets/src/entrypoint/ContentScript-0cff1f94.js",
        "assets/DefineExtensionEntry-d9f2f045.js",
        "assets/Shortcut-4461e19e.js",
        "assets/chunk-E2HJRHOS-fb5a0be5.js"
      ]
    }
  ]
}
